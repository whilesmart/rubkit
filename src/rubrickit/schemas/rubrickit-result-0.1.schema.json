{
  "$defs": {
    "JudgeConfig": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "human",
            "function",
            "llm"
          ],
          "title": "Type",
          "type": "string"
        },
        "ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ref"
        },
        "provider": {
          "default": "router",
          "title": "Provider",
          "type": "string"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "samples": {
          "default": 1,
          "minimum": 1,
          "title": "Samples",
          "type": "integer"
        },
        "temperature": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Temperature"
        },
        "prompt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt"
        },
        "reconcile": {
          "default": "median",
          "enum": [
            "median",
            "mean",
            "majority"
          ],
          "title": "Reconcile",
          "type": "string"
        },
        "disagreement": {
          "default": 0.4,
          "maximum": 1,
          "minimum": 0,
          "title": "Disagreement",
          "type": "number"
        }
      },
      "required": [
        "type"
      ],
      "title": "JudgeConfig",
      "type": "object",
      "patternProperties": {
        "^x-": {}
      }
    },
    "Judgement": {
      "additionalProperties": false,
      "properties": {
        "judge": {
          "title": "Judge",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "rationale": {
          "default": "",
          "title": "Rationale",
          "type": "string"
        },
        "evidence": {
          "items": {
            "type": "string"
          },
          "title": "Evidence",
          "type": "array"
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "status": {
          "default": "scored",
          "enum": [
            "scored",
            "missing",
            "na"
          ],
          "title": "Status",
          "type": "string"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "route": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Route"
        },
        "prompt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt"
        }
      },
      "required": [
        "judge"
      ],
      "title": "Judgement",
      "type": "object",
      "patternProperties": {
        "^x-": {}
      }
    },
    "MetricResult": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "n": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "N"
        },
        "status": {
          "enum": [
            "scored",
            "missing",
            "na"
          ],
          "title": "Status",
          "type": "string"
        },
        "judgements": {
          "items": {
            "$ref": "#/$defs/Judgement"
          },
          "title": "Judgements",
          "type": "array"
        },
        "flags": {
          "items": {
            "type": "string"
          },
          "title": "Flags",
          "type": "array"
        }
      },
      "required": [
        "status"
      ],
      "title": "MetricResult",
      "type": "object",
      "patternProperties": {
        "^x-": {}
      }
    },
    "RubricRecord": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "string"
        },
        "hash": {
          "title": "Hash",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "hash"
      ],
      "title": "RubricRecord",
      "type": "object",
      "patternProperties": {
        "^x-": {}
      }
    },
    "RunRecord": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "started_at": {
          "title": "Started At",
          "type": "string"
        },
        "judges": {
          "additionalProperties": {
            "$ref": "#/$defs/JudgeConfig"
          },
          "title": "Judges",
          "type": "object"
        }
      },
      "required": [
        "id",
        "started_at"
      ],
      "title": "RunRecord",
      "type": "object",
      "patternProperties": {
        "^x-": {}
      }
    },
    "Score": {
      "additionalProperties": false,
      "properties": {
        "raw": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Raw"
        },
        "n": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "N"
        },
        "reported": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reported"
        }
      },
      "required": [
        "n",
        "reported"
      ],
      "title": "Score",
      "type": "object",
      "patternProperties": {
        "^x-": {}
      }
    },
    "Subject": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "content": {
          "default": null,
          "title": "Content"
        },
        "meta": {
          "additionalProperties": true,
          "title": "Meta",
          "type": "object"
        }
      },
      "required": [
        "id"
      ],
      "title": "Subject",
      "type": "object",
      "patternProperties": {
        "^x-": {}
      }
    }
  },
  "additionalProperties": false,
  "properties": {
    "rubric": {
      "$ref": "#/$defs/RubricRecord"
    },
    "subject": {
      "$ref": "#/$defs/Subject"
    },
    "run": {
      "$ref": "#/$defs/RunRecord"
    },
    "metrics": {
      "additionalProperties": {
        "$ref": "#/$defs/MetricResult"
      },
      "title": "Metrics",
      "type": "object"
    },
    "groups": {
      "additionalProperties": {
        "anyOf": [
          {
            "maximum": 1,
            "minimum": 0,
            "type": "number"
          },
          {
            "type": "null"
          }
        ]
      },
      "title": "Groups",
      "type": "object"
    },
    "group_sums": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "null"
          }
        ]
      },
      "title": "Group Sums",
      "type": "object"
    },
    "score": {
      "$ref": "#/$defs/Score"
    },
    "verdict": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Verdict"
    },
    "gates": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Gates",
      "type": "array"
    },
    "flags": {
      "items": {
        "type": "string"
      },
      "title": "Flags",
      "type": "array"
    }
  },
  "required": [
    "rubric",
    "subject",
    "run",
    "metrics",
    "groups",
    "score",
    "verdict"
  ],
  "title": "Result",
  "type": "object",
  "patternProperties": {
    "^x-": {}
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
